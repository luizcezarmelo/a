<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sociedade Espírita Joana D'Arc — Controle de Caixa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#EDEEE9;
    --surface:#FBFAF6;
    --ink:#23262B;
    --ink-soft:#5B6169;
    --indigo:#2F3B52;
    --indigo-2:#465269;
    --sage:#4F7358;
    --sage-bg:#E7EEE8;
    --brick:#8C4438;
    --brick-bg:#F3E7E4;
    --gold:#B08D4F;
    --line:#DBD8CB;
    --radius:14px;
    --shadow:0 1px 2px rgba(35,38,43,.04), 0 8px 24px -12px rgba(35,38,43,.18);
    --font-display:'Fraunces', Georgia, serif;
    --font-body:'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  h1,h2{font-family:var(--font-display); margin:0; font-weight:600;}
  button{font-family:inherit; cursor:pointer;}
  input{font-family:inherit;}
  ::selection{background:var(--gold); color:#fff;}
  :focus-visible{outline:2px solid var(--indigo-2); outline-offset:2px;}

  /* ---------- Login ---------- */
  .login-screen{
    position:fixed; inset:0; display:flex; align-items:center; justify-content:center;
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(176,141,79,.10), transparent 60%),
      var(--paper);
    padding:24px;
    z-index:50;
  }
  .login-screen[hidden]{ display:none !important; }
  .login-card{
    width:100%; max-width:380px;
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:40px 32px 32px;
    text-align:center;
  }
  .login-mark{
    display:block; width:auto; height:56px; max-width:90%; margin:0 auto 18px;
  }
  .login-card p{color:var(--ink-soft); font-size:.9rem; margin:10px 0 22px;}
  #loginForm{display:flex; flex-direction:column; gap:10px;}
  .login-card input{
    padding:12px 14px; border-radius:10px; border:1px solid var(--line);
    background:#fff; font-size:.95rem; color:var(--ink); text-align:center;
    letter-spacing:.04em;
  }
  .login-card input:focus{border-color:var(--indigo-2);}
  .login-card button{
    margin-top:6px; padding:12px 14px; border-radius:10px; border:none;
    background:var(--indigo); color:#fff; font-size:.95rem; font-weight:600;
    transition:background .15s ease;
  }
  .login-card button:hover{background:var(--indigo-2);}
  .login-error{color:var(--brick); font-size:.85rem; min-height:1.2em; margin:14px 0 0;}
  .login-status{color:var(--ink-soft); font-size:.82rem; margin:14px 0 0;}
  .shake{animation:shake .4s ease;}
  @keyframes shake{
    10%,90%{transform:translateX(-1px);}
    20%,80%{transform:translateX(2px);}
    30%,50%,70%{transform:translateX(-4px);}
    40%,60%{transform:translateX(4px);}
  }

  /* ---------- App shell ---------- */
  .app{max-width:1180px; margin:0 auto; padding:28px 24px 64px;}
  .app-header{display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:22px;}
  .brand{display:flex; align-items:center; gap:14px;}
  .brand-mark{height:40px; width:auto; flex:none; display:block;}
  .brand p{margin:0; color:var(--ink-soft); font-size:.82rem; letter-spacing:.03em; text-transform:uppercase;}
  .btn-ghost{background:none; border:none; color:var(--ink-soft); font-size:.85rem; padding:8px 10px; border-radius:8px;}
  .btn-ghost:hover{background:rgba(35,38,43,.06); color:var(--ink);}

  .month-nav{
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    background:var(--surface); border:1px solid var(--line); border-radius:12px;
    padding:10px 14px; margin-bottom:22px;
  }
  .nav-arrow{
    width:32px;height:32px; border-radius:8px; border:1px solid var(--line); background:#fff;
    color:var(--indigo); font-size:1.1rem; line-height:1; display:flex; align-items:center; justify-content:center;
  }
  .nav-arrow:hover{background:var(--paper);}
  .month-display{min-width:170px; text-align:center; font-family:var(--font-display); font-size:1.15rem; color:var(--indigo); font-weight:600;}
  .nav-spacer{flex:1;}
  .btn-outline, .btn-solid{
    padding:9px 16px; border-radius:9px; font-size:.85rem; font-weight:600; border:1px solid var(--indigo);
    white-space:nowrap;
  }
  .btn-outline{background:#fff; color:var(--indigo);}
  .btn-outline:hover{background:var(--paper);}
  .btn-solid{background:var(--indigo); color:#fff;}
  .btn-solid:hover{background:var(--indigo-2);}

  .grid{
    display:grid; grid-template-columns:1fr 1fr; gap:20px;
    grid-template-areas:
      "colab receitas"
      "despesas receitas"
      "saldo saldo";
  }
  #cardColaboradores{grid-area:colab;}
  #cardReceitas{grid-area:receitas;}
  #cardDespesas{grid-area:despesas;}
  #cardSaldo{grid-area:saldo;}

  .card{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
    padding:22px 22px 18px; box-shadow:var(--shadow);
  }
  .card h2{font-size:1.02rem; color:var(--indigo); margin-bottom:14px; font-weight:600;}

  .data-table{width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums;}
  .data-table thead th{
    text-align:left; font-size:.72rem; letter-spacing:.05em; text-transform:uppercase;
    color:var(--ink-soft); font-weight:600; padding:0 8px 8px; border-bottom:1px solid var(--line);
  }
  .data-table thead th.col-valor{text-align:right;}
  .data-table thead th.col-actions{width:34px;}
  .data-table tbody tr{border-bottom:1px solid var(--line);}
  .data-table tbody tr:last-child{border-bottom:none;}
  .data-table td{padding:3px 4px;}
  .data-table input{
    width:100%; border:none; background:transparent; padding:8px; border-radius:6px;
    font-size:.92rem; color:var(--ink);
  }
  .data-table input:focus{background:#fff; box-shadow:0 0 0 1px var(--indigo-2) inset;}
  .data-table .cell-valor{text-align:right; font-variant-numeric:tabular-nums;}
  .row-del{
    width:26px;height:26px;border:none;background:none;color:var(--ink-soft);
    font-size:1rem; border-radius:6px; opacity:.55;
  }
  .row-del:hover{opacity:1; color:var(--brick); background:var(--brick-bg);}

  .btn-add{
    width:100%; margin-top:10px; padding:9px; border-radius:9px; border:1px dashed var(--line);
    background:transparent; color:var(--ink-soft); font-size:.84rem; font-weight:500;
  }
  .btn-add:hover{border-color:var(--indigo-2); color:var(--indigo); background:var(--paper);}

  .card-total{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-top:14px; padding-top:12px; border-top:1px solid var(--line);
    font-size:.92rem;
  }
  .card-total span{color:var(--ink-soft);}
  .card-total strong{font-family:var(--font-display); font-size:1.15rem; color:var(--indigo);}

  .fixed-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:8px 4px; font-size:.9rem; border-bottom:1px dashed var(--line); margin-bottom:4px;
  }
  .fixed-row span, .fixed-row label{color:var(--ink-soft);}
  .fixed-row strong{font-variant-numeric:tabular-nums; color:var(--ink);}
  .input-inline{
    width:130px; text-align:right; padding:6px 8px; border-radius:7px; border:1px solid var(--line);
    background:#fff; font-size:.9rem;
  }

  .card-saldo{
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, var(--indigo), var(--indigo-2));
    color:#fff; text-align:center; padding:30px 24px 26px;
  }
  .card-saldo h2{color:rgba(255,255,255,.75); font-size:.82rem; text-transform:uppercase; letter-spacing:.08em; font-weight:600;}
  .card-saldo strong{display:block; font-family:var(--font-display); font-size:2.4rem; margin:8px 0 4px; font-weight:600;}
  .card-saldo p{margin:0; font-size:.82rem; color:rgba(255,255,255,.7);}
  .card-saldo.negativo strong{color:#F3C7BC;}
  .saldo-flame{
    position:absolute; left:0; top:0; bottom:0; width:5px;
    background:linear-gradient(180deg, var(--gold), transparent);
    animation:flicker 4s ease-in-out infinite;
  }
  @keyframes flicker{
    0%,100%{opacity:.55;} 50%{opacity:1;}
  }
  @media (prefers-reduced-motion:reduce){
    .saldo-flame{animation:none; opacity:.8;}
  }

  .save-indicator{
    text-align:center; font-size:.78rem; color:var(--ink-soft); margin-top:18px;
  }

  @media (max-width:860px){
    .grid{grid-template-columns:1fr; grid-template-areas:"colab" "receitas" "despesas" "saldo";}
    .app{padding:20px 16px 48px;}
    .month-nav{justify-content:center;}
    .nav-spacer{display:none;}
  }

  /* ---------- Report modal ---------- */
  .report-modal{
    position:fixed; inset:0; background:rgba(35,38,43,.55); z-index:60;
    display:flex; align-items:flex-start; justify-content:center; padding:32px 16px; overflow:auto;
  }
  .report-modal[hidden]{ display:none !important; }
  .report-modal-inner{
    background:#fff; width:100%; max-width:720px; border-radius:12px; overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,.35);
  }
  .report-modal-actions{
    display:flex; gap:8px; justify-content:flex-end; padding:14px 20px; background:var(--paper);
    border-bottom:1px solid var(--line);
  }
  #printArea{padding:36px 40px 48px; font-family:var(--font-body); color:var(--ink);}
  .rep-logo{height:40px; width:auto; display:block; margin-bottom:8px;}
  #printArea .rep-sub{color:var(--ink-soft); font-size:.85rem; margin-bottom:22px;}
  #printArea h3{font-family:var(--font-display); font-size:1rem; color:var(--indigo); margin:22px 0 8px; border-bottom:1px solid var(--line); padding-bottom:6px;}
  .rep-summary{display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin:18px 0;}
  .rep-box{background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:12px 14px;}
  .rep-box span{display:block; font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-soft); margin-bottom:4px;}
  .rep-box strong{font-family:var(--font-display); font-size:1.15rem; color:var(--indigo);}
  .rep-box.destaque{background:var(--indigo); grid-column:1 / -1;}
  .rep-box.destaque span{color:rgba(255,255,255,.7);}
  .rep-box.destaque strong{color:#fff; font-size:1.5rem;}
  table.rep-table{width:100%; border-collapse:collapse; font-size:.88rem;}
  table.rep-table th{text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-soft); border-bottom:1px solid var(--line); padding:6px 8px;}
  table.rep-table td{padding:7px 8px; border-bottom:1px solid var(--line);}
  table.rep-table td.num{text-align:right; font-variant-numeric:tabular-nums;}
  table.rep-table th.num{text-align:right;}
  .rep-note{color:var(--ink-soft); font-size:.82rem; font-style:italic;}

  @media print{
    body *{visibility:hidden;}
    #printArea, #printArea *{visibility:visible;}
    #printArea{position:absolute; left:0; top:0; width:100%; padding:0;}
    .no-print{display:none !important;}
  }
</style>
</head>
<body>

  <div id="loginScreen" class="login-screen">
    <div class="login-card" id="loginCard">
      <img class="login-mark" src="data:image/jpeg;base64,
